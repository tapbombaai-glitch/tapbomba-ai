create table if not exists public.flyer_view_once_links (
  id uuid primary key default gen_random_uuid(),

  owner_id uuid
    references auth.users(id)
    on delete cascade
    not null,

  flyer_url text not null,

  token text unique not null,

  expires_at timestamptz not null,

  viewed_at timestamptz,

  created_at timestamptz default now()
);

create index if not exists flyer_view_once_links_token_idx
on public.flyer_view_once_links(token);

create index if not exists flyer_view_once_links_owner_id_idx
on public.flyer_view_once_links(owner_id);

alter table public.flyer_view_once_links
enable row level security;

create policy "Users can create their own view once links"
on public.flyer_view_once_links
for insert
with check (auth.uid() = owner_id);

create policy "Users can view their own view once links"
on public.flyer_view_once_links
for select
using (auth.uid() = owner_id);